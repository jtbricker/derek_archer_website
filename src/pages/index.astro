---
import PageLayout from "../layouts/PageLayout.astro";
import publications from "../data/publications.json";
import researchAreas from "../data/research-areas.json";
import collaborations from "../data/collaborations.json";
import citations from "../data/citations.json";

const featuredPubs = publications.filter((p) => p.featured).slice(0, 4);
const recentPubs = publications.filter((p) => !p.featured).slice(0, 3);
---

<PageLayout title="Derek B. Archer, PhD">
  <!-- HERO SECTION -->
  <section class="relative grid-bg flex min-h-screen items-center overflow-hidden">
    <!-- Ambient glow orbs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute left-1/4 top-1/3 h-96 w-96 rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, var(--color-accent-teal), transparent 70%);"></div>
      <div class="absolute right-1/4 bottom-1/4 h-80 w-80 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, var(--color-accent-purple), transparent 70%);"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 py-24">
      <!-- Eyebrow -->
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
        Neuroimaging &amp; Computational Genetics
      </p>

      <!-- Name -->
      <h1 class="mb-6 text-5xl font-extrabold leading-tight md:text-7xl" style="font-family: var(--font-heading);">
        Derek B. Archer<span class="bg-gradient-to-r from-[#14b8a6] to-[#8b5cf6] bg-clip-text text-transparent">, PhD</span>
      </h1>

      <!-- Summary -->
      <p class="mb-4 max-w-2xl text-lg leading-relaxed md:text-xl" style="color: var(--color-text-muted);">
        Developing advanced neuroimaging and machine learning methods to identify brain signatures of neurodegeneration.
      </p>

      <!-- Affiliation -->
      <p class="mb-8 text-base" style="color: var(--color-text-muted);">
        Assistant Professor of Neurology · <span style="color: var(--color-accent-gold);">Vanderbilt University Medical Center</span>
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/research/"
          class="inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold transition-all duration-200 hover:shadow-lg"
          style="background: var(--color-accent-teal); color: var(--color-midnight-base);"
        >
          Explore Research →
        </a>
        <a
          href="/publications/"
          class="inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold transition-all duration-200 hover:bg-white/5"
          style="border-color: var(--color-midnight-border); color: var(--color-text-body);"
        >
          Publications
        </a>
      </div>
    </div>
  </section>

  <!-- METRICS BANNER -->
  <section style="background: var(--color-midnight-surface);">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-10 md:grid-cols-4">
      {[
        { value: citations.totalCitations.toLocaleString() + "+", label: "Citations" },
        { value: citations.totalPublications + "+", label: "Publications" },
        { value: citations.cohortsLed.toString(), label: "Research Cohorts" },
        { value: "h-" + citations.hIndex, label: "H-Index" },
      ].map((metric) => (
        <div class="text-center">
          <p class="glow-teal text-3xl font-bold md:text-4xl" style="color: var(--color-accent-teal); font-family: var(--font-heading);">
            {metric.value}
          </p>
          <p class="mt-1 text-xs uppercase tracking-wider" style="color: var(--color-text-muted); font-family: var(--font-mono);">
            {metric.label}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- RESEARCH AREAS -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
        Research Focus
      </p>
      <h2 class="mb-10 text-3xl font-bold md:text-4xl">Areas of Investigation</h2>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {researchAreas.map((area) => {
          const colorVar = area.color === "teal" ? "--color-accent-teal"
            : area.color === "purple" ? "--color-accent-purple"
            : "--color-accent-gold";
          return (
            <div class="glass-card p-6 transition-all duration-300 hover:-translate-y-1">
              <div
                class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-2xl"
                style={`background: color-mix(in srgb, var(${colorVar}) 15%, transparent);`}
              >
                {area.icon}
              </div>
              <h3 class="mb-2 text-lg font-semibold" style="color: var(--color-text-heading);">
                {area.title}
              </h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {area.shortDescription}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FEATURED PUBLICATIONS -->
  <section class="py-20" style="background: var(--color-midnight-surface);">
    <div class="mx-auto max-w-6xl px-6">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
        Selected Works
      </p>
      <h2 class="mb-10 text-3xl font-bold md:text-4xl">Featured Publications</h2>

      <div class="space-y-6">
        {featuredPubs.map((pub) => (
          <article class="border-l-2 py-4 pl-6" style={`border-color: var(--color-accent-teal);`}>
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <span
                class="rounded-full px-2.5 py-0.5 text-xs font-semibold"
                style={pub.role === "first"
                  ? "background: rgba(20, 184, 166, 0.15); color: var(--color-accent-teal);"
                  : "background: rgba(245, 158, 11, 0.15); color: var(--color-accent-gold);"
                }
              >
                {pub.role === "first" ? "1st Author" : "Last Author"}
              </span>
              <span class="text-xs" style="color: var(--color-text-muted); font-family: var(--font-mono);">{pub.year}</span>
            </div>
            <h3 class="mb-1 text-base font-semibold leading-snug md:text-lg" style="color: var(--color-text-heading);">
              {pub.title}
            </h3>
            <p class="text-sm" style="color: var(--color-text-muted);">
              {pub.authors}
            </p>
            <p class="mt-1 text-sm font-medium" style="color: var(--color-accent-teal);">
              {pub.journal}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/publications/"
          class="inline-flex items-center gap-2 rounded-lg border px-6 py-3 text-sm font-semibold transition-all duration-200 hover:bg-white/5"
          style="border-color: var(--color-midnight-border); color: var(--color-text-body);"
        >
          View All Publications →
        </a>
      </div>
    </div>
  </section>

  <!-- COLLABORATIONS -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
        Affiliations
      </p>
      <h2 class="mb-10 text-3xl font-bold md:text-4xl">Research Collaborations</h2>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {collaborations.map((collab) => (
          <div class="glass-card p-6 text-center transition-all duration-300 hover:-translate-y-1">
            <p class="glow-gold text-2xl font-bold md:text-3xl" style="color: var(--color-accent-gold); font-family: var(--font-heading);">
              {collab.acronym}
            </p>
            <p class="mt-2 text-sm" style="color: var(--color-text-muted);">
              {collab.name}
            </p>
            <p class="mt-2 text-xs font-medium" style="color: var(--color-text-muted); font-family: var(--font-mono);">
              {collab.role}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

---
import PageLayout from "../layouts/PageLayout.astro";
import researchAreas from "../data/research-areas.json";
import collaborations from "../data/collaborations.json";
---

<PageLayout title="Research" description="Research areas in neuroimaging, computational genetics, white matter neurodegeneration, and AI-derived brain signatures.">
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
        Research
      </p>
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">Areas of Investigation</h1>
      <p class="mb-12 text-lg" style="color: var(--color-text-muted);">
        My research combines advanced neuroimaging, computational genetics, and artificial intelligence to understand how the brain changes with age and disease.
      </p>

      <!-- Research Areas (expanded) -->
      <div class="space-y-8 mb-20">
        {researchAreas.map((area) => {
          const colorVar = area.color === "teal" ? "--color-accent-teal"
            : area.color === "purple" ? "--color-accent-purple"
            : "--color-accent-gold";
          return (
            <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1">
              <div class="flex items-start gap-4">
                <div
                  class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl"
                  style={`background: color-mix(in srgb, var(${colorVar}) 15%, transparent);`}
                >
                  {area.icon}
                </div>
                <div>
                  <h2 class="mb-2 text-xl font-bold" style="color: var(--color-text-heading);">
                    {area.title}
                  </h2>
                  <p class="leading-relaxed" style="color: var(--color-text-body);">
                    {area.description}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Collaborations -->
      <div>
        <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style="color: var(--color-accent-teal); font-family: var(--font-mono);">
          Affiliations
        </p>
        <h2 class="mb-8 text-3xl font-bold">Research Collaborations</h2>

        <div class="grid gap-6 md:grid-cols-2">
          {collaborations.map((collab) => (
            <div class="glass-card p-6 transition-all duration-300 hover:-translate-y-1">
              <p class="glow-gold text-xl font-bold" style="color: var(--color-accent-gold); font-family: var(--font-heading);">
                {collab.acronym}
              </p>
              <p class="mt-1 text-sm font-medium" style="color: var(--color-text-heading);">
                {collab.name}
              </p>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {collab.description}
              </p>
              <p class="mt-3 text-xs font-medium" style="color: var(--color-text-muted); font-family: var(--font-mono);">
                Role: {collab.role}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>
